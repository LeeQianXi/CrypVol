<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>CrypVol.Lib</RootNamespace>
        <Authors>QianXiLee</Authors>
        <Title>Cryptographic Volume Package</Title>
        <RepositoryUrl>https://github.com/LeeQianXi/CrypVol</RepositoryUrl>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <NeutralLanguage>zh-Hans</NeutralLanguage>
        <!-- CVK JSON 模型支持 self-contained 发布环境；保留运行时反射序列化能力。 -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CrypVol.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0"/>
        <PackageReference Include="DotNet.Glob" Version="3.1.3"/>
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10"/>
        <PackageReference Include="SSH.NET" Version="2026.0.0"/>
    </ItemGroup>
</Project>
